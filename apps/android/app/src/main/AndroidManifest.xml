<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground one-shot speech and an explicitly initiated, time-limited microphone FGS. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Short CPU wake lock only during explicit 60 s local voice test. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- User must grant JARVIS access in Shizuku; package installation is not permission. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API" />
    <!-- Granted explicitly by Android; required for the fixed, local Termux diagnostic. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.rosan.dhizuku" />
        <package android:name="com.bintianqi.owndroid" />
        <package android:name="com.termux" />
        <package android:name="com.cardenaspiero255.gamehubultra" />
        <!-- Scoped package visibility: launchable apps only, no QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="@string/jarvis_application_label"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:supportsRtl="true">
        <!-- Optional HOME candidate: Android lets the user choose, never changes default automatically. -->
        <activity
            android:name=".JarvisHomeActivity"
            android:exported="true"
            android:label="JARVIS OS V3">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".OwnerVoiceEnrollmentActivity"
            android:exported="false" />
        <activity
            android:name=".CompanionCenterActivity"
            android:exported="false" />
        <!-- Receives Termux one-shot result only through an explicit PendingIntent. -->
        <receiver
            android:name=".TermuxResultReceiver"
            android:exported="false" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".OmegaHandsService"
            android:exported="true"
            android:label="@string/omega_hands_label"
            android:description="@string/omega_hands_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/omega_hands_service" />
        </service>
        <!-- 60-second hardware preview only; no boot receiver, no autostart. -->
        <service
            android:name=".HandsFreePreviewService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".ScreenObservationService"
            android:enabled="false"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="false" />
    </application>
</manifest>
